# Cross-compile pertisk-proxy binaries for Linux (amd64 or arm64 via buildx).
# Usage: docker buildx build --platform linux/amd64 -f docker/Dockerfile.release .
#
# Uses Debian bookworm (not Alpine) so apt mirrors can succeed when Alpine CDN fails.
# BUILDPLATFORM / TARGET* are injected by BuildKit — do not declare them before FROM.
# Default base is Public ECR mirror (avoids docker.io timeouts on self-hosted runners).

ARG RUST_IMAGE=harbor.tools.pertisk.com/pertisk-proxy/rust:1-bookworm

FROM --platform=$BUILDPLATFORM ${RUST_IMAGE} AS builder

ARG TARGETARCH
ARG BUILDARCH
ARG TARGETPLATFORM
ARG PACKAGE_TARGET=all
ARG VERSION=0.1.0

COPY docker/debian-apt-setup.sh /usr/local/sbin/debian-apt-setup.sh
RUN set -eux; \
    . /usr/local/sbin/debian-apt-setup.sh; \
    apt_install_retry \
      build-essential \
      pkg-config \
      libssl-dev \
      perl \
      cmake \
      clang \
      golang-go \
      curl \
      ca-certificates \
      xz-utils \
      git; \
    if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
      install_zig "${BUILDARCH}"; \
      cargo install cargo-zigbuild --locked; \
    fi; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock* build.rs ./
# Workspace members must exist for cargo fetch/build (proxy does not compile them here).
COPY tunnel/proto/Cargo.toml tunnel/proto/
COPY tunnel/server/Cargo.toml tunnel/server/
COPY tunnel/client/Cargo.toml tunnel/client/
RUN mkdir -p tunnel/proto/src tunnel/server/src tunnel/client/src \
    && touch tunnel/proto/src/lib.rs tunnel/server/src/main.rs tunnel/client/src/main.rs
RUN test -f Cargo.lock || cargo generate-lockfile

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-proxy-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-proxy-git-${TARGETPLATFORM} \
    cargo fetch --locked

COPY src ./src
COPY tunnel ./tunnel
COPY docker/release-build.sh /usr/local/sbin/release-build

ARG CARGO_BUILD_JOBS
ARG VERSION=0.1.0
ENV pertisk_proxy_VERSION=${VERSION}
ENV RUST_MIN_STACK=16777216
ENV PACKAGE_TARGET=${PACKAGE_TARGET}
ENV TARGETPLATFORM=${TARGETPLATFORM}
ENV TARGETARCH=${TARGETARCH}
ENV BUILDARCH=${BUILDARCH}

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-proxy-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-proxy-git-${TARGETPLATFORM} \
    --mount=type=cache,target=/app/target,sharing=locked,id=pertisk-proxy-target-${TARGETPLATFORM} \
    chmod +x /usr/local/sbin/release-build \
    && echo "release-build: TARGETPLATFORM=${TARGETPLATFORM} TARGETARCH=${TARGETARCH} BUILDARCH=${BUILDARCH}" \
    && release-build

# Export binaries for buildx -o type=local (works cross-arch; --load does not).
FROM scratch AS artifacts
COPY --from=builder /app/out/ /
