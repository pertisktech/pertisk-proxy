# fpm environment for .deb / .rpm (GNU tar + rpmbuild).
# Debian bookworm: fpm + dpkg-dev + rpmbuild. Use apt mirror helper for flaky CDNs.
FROM debian:bookworm-slim

COPY docker/debian-apt-setup.sh /usr/local/sbin/debian-apt-setup.sh
RUN set -eux; \
    . /usr/local/sbin/debian-apt-setup.sh; \
    apt_install_retry \
      ca-certificates \
      curl \
      ruby \
      ruby-dev \
      build-essential \
      rpm \
      cpio \
      zip \
      xz-utils; \
    gem install --no-document fpm; \
    rm -rf /var/lib/apt/lists/*; \
    fpm --version

WORKDIR /work
