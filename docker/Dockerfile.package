# fpm environment for .deb / .rpm (GNU tar + rpmbuild).
# AlmaLinux: matches self-hosted runners; avoids broken Debian apt indexes in Docker.
FROM almalinux:9

RUN set -eux; \
    dnf -y install epel-release; \
    dnf -y install \
      ca-certificates \
      curl \
      ruby \
      ruby-devel \
      gcc \
      gcc-c++ \
      make \
      rpm-build \
      cpio \
      zip \
      tar \
      gzip \
      which \
      binutils \
      xz; \
    dnf -y install dpkg || true; \
    gem install --no-document fpm; \
    dnf clean all; \
    fpm --version

WORKDIR /work
