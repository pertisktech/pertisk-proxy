# Linux environment for building .deb and .rpm with fpm (GNU tar, dpkg/rpmbuild).
# Alpine matches docker/Dockerfile.release (musl cross-build artifacts).
FROM alpine:3.21

RUN apk add --no-cache \
    ca-certificates \
    curl \
    ruby \
    ruby-dev \
    build-base \
    rpm \
    cpio \
    zip \
    && gem install --no-document fpm

WORKDIR /work
