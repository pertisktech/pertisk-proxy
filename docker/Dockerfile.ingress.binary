# Runtime-only ingress image using a prebuilt glibc binary from CI artifacts.
# Avoid Alpine apk CDN issues; matches gnu binaries from release builds.
# docker build --network=host -f docker/Dockerfile.ingress.binary \
#   --build-arg BINARY_FILE=pertisk-proxy-ingress-linux-amd64 \
#   -t pertisk-proxy-ingress:amd64 .

ARG DEBIAN_IMAGE=public.ecr.aws/docker/library/debian:bookworm-slim

FROM ${DEBIAN_IMAGE}

COPY docker/debian-apt-setup.sh /usr/local/sbin/debian-apt-setup.sh
RUN set -eux; \
    . /usr/local/sbin/debian-apt-setup.sh; \
    apt_install_retry ca-certificates openssl libssl3 curl; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/share/pertisk-proxy

ARG BINARY_FILE=pertisk-proxy-ingress-linux-amd64
COPY ${BINARY_FILE} /usr/local/bin/pertisk-proxy-ingress
COPY admin/dist ./admin/dist/

ENV PERTISK_MANAGEMENT_ADDR=0.0.0.0:9080
ENV PERTISK_METRICS_ADDR=0.0.0.0:9990

EXPOSE 80 443 443/udp 9080 9990

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:9080/live || exit 1

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pertisk-proxy-ingress"]
