# Runtime-only ingress image using a prebuilt glibc binary from CI artifacts.
# Base must already live on Harbor (no docker.io / ECR pulls on locked-down runners):
#   ./build/ci-push-runtime-base.sh
#
# COPY-only (no target-arch RUN) so amd64 runners can publish arm64 without QEMU.

# syntax=docker/dockerfile:1.7

ARG DEBIAN_IMAGE=harbor.tools.pertisk.com/pertisk-proxy/runtime:bookworm

FROM ${DEBIAN_IMAGE}

WORKDIR /usr/share/pertisk-proxy

ARG BINARY_FILE=pertisk-proxy-ingress-linux-amd64
COPY --chmod=755 ${BINARY_FILE} /usr/local/bin/pertisk-proxy-ingress
COPY admin/dist ./admin/dist/

ENV PERTISK_MANAGEMENT_ADDR=0.0.0.0:9080
ENV PERTISK_METRICS_ADDR=0.0.0.0:9990

EXPOSE 80 443 443/udp 9080 9990

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:9080/live || exit 1

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pertisk-proxy-ingress"]
