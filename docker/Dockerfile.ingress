# Build pertisk-proxy-ingress (Kubernetes Ingress + Gateway API controller).
# TARGETPLATFORM / TARGETARCH are injected by buildx — do not default them to amd64.

FROM node:22-bookworm AS admin
WORKDIR /admin
COPY admin/package.json admin/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY admin/ ./
RUN pnpm build

# Build on TARGETPLATFORM so each manifest entry gets a native binary (buildx + QEMU).
FROM --platform=$TARGETPLATFORM rust:1-bookworm AS builder

ARG TARGETPLATFORM
ARG TARGETARCH
ARG VERSION=0.1.0

COPY docker/apt-bookworm-install.sh /usr/local/sbin/apt-bookworm-install
RUN chmod +x /usr/local/sbin/apt-bookworm-install \
    && apt-bookworm-install \
    build-essential \
    cmake \
    clang \
    libclang-dev \
    golang-go \
    nasm \
    file

WORKDIR /app

COPY Cargo.toml Cargo.lock build.rs ./
RUN test -f Cargo.lock || cargo generate-lockfile

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-ingress-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-ingress-git-${TARGETPLATFORM} \
    cargo fetch --locked

COPY src ./src
COPY --from=admin /admin/dist ./admin/dist

ARG CARGO_BUILD_JOBS=1
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
ENV pertisk_proxy_VERSION=${VERSION}
ENV RUST_MIN_STACK=16777216

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-ingress-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-ingress-git-${TARGETPLATFORM} \
    --mount=type=cache,target=/app/target,sharing=locked,id=pertisk-ingress-target-${TARGETPLATFORM} \
    set -eu; \
    cargo build --release --locked --bin pertisk-proxy-ingress --features ingress; \
    cp /app/target/release/pertisk-proxy-ingress /app/pertisk-proxy-ingress; \
    case "${TARGETARCH}" in \
      amd64) file /app/pertisk-proxy-ingress | grep -Eq 'x86-64|Intel 80386' ;; \
      arm64) file /app/pertisk-proxy-ingress | grep -Eq 'aarch64|ARM' ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}"; exit 1 ;; \
    esac

FROM --platform=$TARGETPLATFORM debian:bookworm-slim

ARG TARGETPLATFORM
ARG TARGETARCH

COPY docker/apt-bookworm-install.sh /usr/local/sbin/apt-bookworm-install
RUN chmod +x /usr/local/sbin/apt-bookworm-install \
    && apt-bookworm-install ca-certificates

COPY --from=builder /app/pertisk-proxy-ingress /usr/local/bin/pertisk-proxy-ingress
COPY --from=admin /admin/dist /usr/share/pertisk-proxy/admin/dist

USER 65532:65532
EXPOSE 8080 8443 8443/udp 9080
ENTRYPOINT ["/usr/local/bin/pertisk-proxy-ingress"]
