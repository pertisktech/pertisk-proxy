# Build pertisk-proxy-ingress (Kubernetes Ingress + Gateway API controller).
# TARGETPLATFORM / TARGETARCH are injected by buildx per --platform (do not hardcode defaults).
#
# All RUN steps execute on BUILDPLATFORM (native on the build host). Cross-compilation
# uses cargo-zigbuild (works arm64→amd64 and amd64→arm64). musl.cc -cross toolchains
# are x86_64-hosted only and fail on arm64 build hosts.
# The final stage is COPY-only (scratch) — no target-platform RUN (avoids exec format error).

ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG TARGETARCH
ARG BUILDARCH

FROM --platform=$BUILDPLATFORM node:22-alpine AS admin
WORKDIR /admin
COPY admin/package.json admin/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY admin/ ./
RUN pnpm build

FROM --platform=$BUILDPLATFORM rust:1-alpine3.21 AS builder

ARG TARGETPLATFORM
ARG TARGETARCH
ARG BUILDARCH
ARG VERSION=0.1.0

RUN set -eux; \
    if ! grep -qE '^[^#[:space:]].*/community' /etc/apk/repositories; then \
      sed -i -e 's|^[#[:space:]]*\(.*\/community\)|\1|' /etc/apk/repositories; \
    fi; \
    if ! grep -qE '^[^#[:space:]].*/community' /etc/apk/repositories; then \
      echo "https://dl-cdn.alpinelinux.org/alpine/v3.21/community" >> /etc/apk/repositories; \
    fi; \
    apk update; \
    apk add --no-cache \
      build-base \
      pkgconf \
      openssl-dev \
      perl \
      cmake \
      clang \
      clang-dev \
      go \
      file \
      curl \
      musl-dev; \
    if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
      apk add --no-cache zig; \
      cargo install cargo-zigbuild --locked; \
    fi

WORKDIR /app

COPY Cargo.toml Cargo.lock build.rs ./
# Workspace members must exist for cargo fetch/build (ingress does not compile them here).
COPY tunnel/proto/Cargo.toml tunnel/proto/
COPY tunnel/server/Cargo.toml tunnel/server/
COPY tunnel/client/Cargo.toml tunnel/client/
RUN mkdir -p tunnel/proto/src tunnel/server/src tunnel/client/src \
    && touch tunnel/proto/src/lib.rs tunnel/server/src/main.rs tunnel/client/src/main.rs
RUN test -f Cargo.lock || cargo generate-lockfile

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-ingress-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-ingress-git-${TARGETPLATFORM} \
    cargo fetch --locked

COPY src ./src
COPY tunnel ./tunnel
COPY --from=admin /admin/dist ./admin/dist
COPY docker/ingress-build.sh /usr/local/sbin/ingress-build

ARG CARGO_BUILD_JOBS
ENV pertisk_proxy_VERSION=${VERSION}
ENV RUST_MIN_STACK=16777216
ENV TARGETPLATFORM=${TARGETPLATFORM}
ENV TARGETARCH=${TARGETARCH}
ENV BUILDARCH=${BUILDARCH}

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-ingress-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-ingress-git-${TARGETPLATFORM} \
    --mount=type=cache,target=/app/target,sharing=locked,id=pertisk-ingress-target-${TARGETPLATFORM} \
    chmod +x /usr/local/sbin/ingress-build \
    && echo "ingress-build: TARGETPLATFORM=${TARGETPLATFORM} TARGETARCH=${TARGETARCH} BUILDARCH=${BUILDARCH}" \
    && ingress-build

# COPY-only final stage: works for any --platform without QEMU/binfmt on the build host.
FROM scratch
COPY --from=builder /runtime /
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
USER 65532:65532
EXPOSE 8080 8443 8443/udp 9080
ENTRYPOINT ["/usr/local/bin/pertisk-proxy-ingress"]
