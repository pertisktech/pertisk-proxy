# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY config ./config
RUN cargo build --release --bin pertisk-proxy

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/pertisk-proxy /usr/local/bin/pertisk-proxy
COPY config/examples/routes.yaml /etc/pertisk-proxy/routes.yaml
USER 65532:65532
EXPOSE 80 443 443/udp
ENV ROUTES_CONFIG=/etc/pertisk-proxy/routes.yaml
ENTRYPOINT ["/usr/local/bin/pertisk-proxy"]
