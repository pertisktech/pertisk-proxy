# syntax=docker/dockerfile:1.7

# Same Harbor-only CI pattern as root Dockerfile (SKIP_* + prebaked bases).

ARG RUST_IMAGE=public.ecr.aws/docker/library/rust:1-alpine3.21
ARG ALPINE_IMAGE=public.ecr.aws/docker/library/alpine:3.21
ARG SKIP_BUILD_DEPS=0
ARG SKIP_RUNTIME_APK=0
ARG VERSION=0.1.0

FROM --platform=$BUILDPLATFORM ${RUST_IMAGE} AS builder
ARG TARGETPLATFORM
ARG TARGETARCH
ARG BUILDARCH
ARG SKIP_BUILD_DEPS=0
ARG VERSION=0.1.0

COPY docker/alpine-apk-setup.sh /usr/local/sbin/alpine-apk-setup.sh
RUN set -eux; \
    if [ "${SKIP_BUILD_DEPS}" = "1" ]; then \
      echo "SKIP_BUILD_DEPS=1 (using prebaked builder image)"; \
      command -v cargo >/dev/null; \
    else \
      . /usr/local/sbin/alpine-apk-setup.sh; \
      apk_add_retry \
        build-base \
        pkgconf \
        openssl-dev \
        perl \
        musl-dev \
        cmake \
        clang \
        clang-dev \
        go; \
      if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
        apk_add_retry zig; \
        cargo install cargo-zigbuild --locked; \
      fi; \
    fi

WORKDIR /app

COPY Cargo.toml Cargo.lock build.rs ./
COPY tunnel/proto/Cargo.toml tunnel/proto/
COPY tunnel/server/Cargo.toml tunnel/server/
COPY tunnel/client/Cargo.toml tunnel/client/
RUN mkdir -p tunnel/proto/src tunnel/server/src tunnel/client/src \
    && touch tunnel/proto/src/lib.rs tunnel/server/src/main.rs tunnel/client/src/main.rs
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-proxy-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-proxy-git-${TARGETPLATFORM} \
    cargo fetch --locked

COPY src ./src
COPY tunnel ./tunnel
ENV pertisk_proxy_VERSION=${VERSION}
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked,id=pertisk-proxy-registry-${TARGETPLATFORM} \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked,id=pertisk-proxy-git-${TARGETPLATFORM} \
    --mount=type=cache,target=/app/target,sharing=locked,id=pertisk-proxy-target-${TARGETPLATFORM} \
    case "${TARGETARCH}" in \
      amd64) RUST_TARGET=x86_64-unknown-linux-musl ;; \
      arm64) RUST_TARGET=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && rustup target add "${RUST_TARGET}" \
    && if [ "${TARGETARCH}" != "${BUILDARCH}" ]; then \
         cargo zigbuild --release --locked --target "${RUST_TARGET}" \
           --bin pertisk-proxy --features admin,acme,dns-challenge,h3-quinn; \
       else \
         cargo build --release --locked --target "${RUST_TARGET}" \
           --bin pertisk-proxy --features admin,acme,dns-challenge,h3-quinn; \
       fi \
    && install -D "/app/target/${RUST_TARGET}/release/pertisk-proxy" /usr/local/bin/pertisk-proxy

FROM ${ALPINE_IMAGE}
ARG SKIP_RUNTIME_APK=0
COPY docker/alpine-apk-setup.sh /usr/local/sbin/alpine-apk-setup.sh
RUN set -eux; \
    if [ "${SKIP_RUNTIME_APK}" = "1" ]; then \
      echo "SKIP_RUNTIME_APK=1 (using prebaked alpine runtime)"; \
      test -f /etc/ssl/certs/ca-certificates.crt; \
      mkdir -p /var/lib/pertisk-proxy/certs; \
    else \
      . /usr/local/sbin/alpine-apk-setup.sh; \
      apk_add_retry ca-certificates openssl; \
      mkdir -p /var/lib/pertisk-proxy/certs; \
    fi
COPY --from=builder /usr/local/bin/pertisk-proxy /usr/local/bin/pertisk-proxy
COPY build/pertisk-proxy.conf /etc/pertisk-proxy/pertisk-proxy.conf
USER 65532:65532
VOLUME /var/lib/pertisk-proxy
EXPOSE 80 443 443/udp 9080
ENV PERTISK_DB_PATH=/var/lib/pertisk-proxy/proxy.sqlite
ENV PERTISK_MANAGEMENT_ADDR=0.0.0.0:9080
ENTRYPOINT ["/usr/local/bin/pertisk-proxy"]
