[Unit]
Description=pertisk-tunnel-server (reverse tunnel for pertisk-proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pertisk-tunnel
Group=pertisk-tunnel
ExecStart=/usr/bin/pertisk-tunnel-server --config /etc/pertisk-tunnel/server.toml
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
