# Rust build artifacts (often root-owned after `sudo make dev`)
/target
**/*.rs.bk

# Package outputs (DEB/RPM/tarballs; runtime binaries are needed by docker/Dockerfile.*.binary)
/release
/pkg-*
/.buildx-cache
/preinstall.sh
/postinstall.sh
/preremove.sh

# Admin UI deps (dist is copied into runtime images from CI artifacts)
/admin/node_modules

# Local runtime data
/data
.env
*.pem
*.crt
*.key

# Git / IDE
.git
.gitignore
.cursor
**/.DS_Store

# Docs and dev-only (not needed in release Docker builds)
*.md
Makefile
